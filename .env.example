# Copy this file to .env and set a password. The container won't start without one.
# Every setting lives here: nothing in docker-compose.yml needs editing. Lines starting
# with # are switched off and show the default or an example. After a change, run:
#     docker compose up -d
# The status page lists every setting with its current value ("Every setting").

# ---------------------------------------------------------------- the login (required)
WEBDAV_USER=rar2fs
WEBDAV_PASS=change-me

# ---------------------------------------------------------------- network shares
# Only needed if docker-compose.override.yml uses a network share
# NAS_USER=nasuser
# NAS_PASS=naspassword

# ---------------------------------------------------------------- other devices and HTTPS
# HTTPS is on by default, with a certificate the container creates in tls/.
# Addresses or names OTHER devices use to reach this PC, comma-separated. Needed
# before another machine (e.g. a Plex server) can connect:
# TLS_HOSTS=192.168.1.10
# Plain HTTP instead (see "HTTPS" in the README):
# TLS=0
# Let only this PC connect - no other device on the network can reach it:
# BIND=127.0.0.1
# Wrong logins allowed in 10 seconds before new logins are refused for a while:
# LOGIN_GUESS_LIMIT=5

# ---------------------------------------------------------------- long names on Windows
# A second view of the drive (port 8767) where paths too long for Windows are
# shortened. The Windows scripts on this PC then use it automatically.
# SHORT_PATHS=1
# The longest path allowed in that view, counted from the drive's root:
# MAX_PATH=230

# ---------------------------------------------------------------- what the drive shows
# Open archives inside archives too (e.g. scene subtitle packs). 0 = off:
# NESTED_RAR=1
# Files and folders to leave out, ;-separated. "HIDE=" (nothing after it) shows everything:
# HIDE=*.sfv;Thumbs.db;desktop.ini;.DS_Store;@Recycle/**;.qsyncclient/**;Sample/**;Proof/**
# Passwords for encrypted archives go in config/passwords.conf - see "Password-protected
# archives" in the README.

# ---------------------------------------------------------------- media servers
# Tell your media server to scan a folder as soon as it changes. Set up any of the
# three, or several. Each needs its address, a token or key, and where each of your
# folders is on that machine (see "Telling your media server about new files").
#
# Plex (PLEX_TOKEN: see the README; windows\connect-plex.ps1 can fetch it for you)
# PLEX_URL=http://192.168.1.20:32400
# PLEX_TOKEN=
# PLEX_PATH_MAP=tv=/mnt/media/tv;films=/mnt/media/films
#   ... or for Plex running on this Windows PC (Y: is the rar2fs drive):
# PLEX_URL=http://host.docker.internal:32400
# PLEX_PATH_MAP=tv=Y:\tv;films=Y:\films
#
# Jellyfin (key: Dashboard > API Keys)
# JELLYFIN_URL=http://192.168.1.20:8096
# JELLYFIN_API_KEY=
# JELLYFIN_PATH_MAP=tv=/mnt/media/tv;films=/mnt/media/films
#
# Emby (key: Settings > API Keys)
# EMBY_URL=http://192.168.1.20:8096
# EMBY_API_KEY=
# EMBY_PATH_MAP=tv=/mnt/media/tv;films=/mnt/media/films
#
# Whether a server on Windows is told the shortened folder names of the short-names
# view. auto (the default) = yes when SHORT_PATHS=1. Set 0 if that drive was mounted
# with -Original, or 1 to force it. One per server:
# PLEX_SHORT_NAMES=auto
# JELLYFIN_SHORT_NAMES=auto
# EMBY_SHORT_NAMES=auto
# Timing, for all three (the names are from when only Plex was supported): seconds
# between looks, seconds to wait after the last change, folder levels to watch.
# PLEX_POLL_SECONDS=60
# PLEX_SETTLE_SECONDS=90
# PLEX_WATCH_DEPTH=4

# ---------------------------------------------------------------- watching over it
# Alerts when the container is unhealthy, an update is out, or the health report finds
# new problems. An ntfy topic, a Discord webhook or a Slack webhook.
# NOTIFY_URL=https://ntfy.sh/pick-a-long-random-topic-name
# For dashboards and monitoring apps (see "Dashboards and monitoring").
# A URL pinged every minute while healthy (Uptime Kuma push monitor, Healthchecks.io):
# HEARTBEAT_URL=https://uptime.example.com/api/push/abc123?status=up&msg=OK
# A read-only token for status.json and /metrics, for apps that can't send a login:
# STATUS_TOKEN=pick-a-long-random-string
# Restart by itself after three failed health checks. 0 = off:
# AUTO_RESTART=1
# Days between scheduled health reports. 0 = never:
# HEALTH_REPORT_DAYS=7
# Minutes between rebuilds of the index behind search, recently added and duplicates:
# LIBRARY_INDEX_MINUTES=10

# ---------------------------------------------------------------- fine-tuning
# Options passed to rar2fs. The defaults speed up large multi-part sets and read every
# archive's header at start-up, so the first scan is fast:
# RAR2FS_OPTS=--seek-length=1 -o warmup
# How long the drive remembers a folder's listing before looking again:
# DIR_CACHE_TIME=15s
# Extra options for the WebDAV server (rclone serve webdav), if you ever need one:
# RCLONE_OPTS=

# ---------------------------------------------------------------- Linux hosts only
# With AppArmor (see "Security" in the README):
# APPARMOR_PROFILE=rar2fs-dock
