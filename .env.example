# Copy to .env and set a password. Required when the server is open to the network.
WEBDAV_USER=rar2fs
WEBDAV_PASS=change-me

#Optional: Only needed if docker-compose.yml uses a network share
# NAS_USER=nasuser
# NAS_PASS=naspassword

# Optional: ask Plex to scan a folder as soon as it changes
# PLEX_URL=http://192.168.1.50:32400
# PLEX_TOKEN=
# Where each folder is mounted on the Plex server
# PLEX_PATH_MAP=tv=/mnt/media/tv;films=/mnt/media/films

# Optional: a second view of the drive (port 8767) where paths too long for Windows
# are shortened. The Windows scripts on this PC then use it automatically.
# SHORT_PATHS=1
