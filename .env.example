# Copy this file to .env and set a password. The container won't start without one.
# Everything after WEBDAV_USER and WEBDAV_PASS is optional.
WEBDAV_USER=rar2fs
WEBDAV_PASS=change-me

#Optional: Only needed if docker-compose.yml uses a network share
# NAS_USER=nasuser
# NAS_PASS=naspassword

# Optional: ask Plex to scan a folder as soon as it changes
# PLEX_URL=http://192.168.1.50:32400
# PLEX_TOKEN=
# Where each folder is mounted on the Plex server
# PLEX_PATH_MAP=tv=/mnt/media/tv;films=/mnt/media/films

# Optional: alerts when the container is unhealthy, an update is out, or the health
# report finds new problems. An ntfy topic, a Discord webhook or a Slack webhook.
# NOTIFY_URL=https://ntfy.sh/pick-a-long-random-topic-name

# HTTPS is on by default, with a certificate the container creates in tls/.
# Addresses or names OTHER devices use to reach this PC, comma-separated. Needed
# before another machine (e.g. a Plex server) can connect:
# TLS_HOSTS=192.168.1.63
# Plain HTTP instead (see "HTTPS" in the README):
# TLS=0

# Linux hosts with AppArmor only (see "Security" in the README):
# APPARMOR_PROFILE=rar2fs-dock
