#!/bin/sh
# Looks up the newest unrar, rar2fs and rclone releases, and the newest rar2fs-dock
# (the VERSION file on GitHub), and records them in /state/versions. Prints a line for each one that is newer than what this image was
# built with. (unrar reads the archives and rclone is the server other devices talk to,
# so those are the two worth keeping current.)
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

latest_unrar=$(curl -fsSL -m 20 https://www.rarlab.com/rar_add.htm 2>/dev/null |
  grep -o 'unrarsrc-[0-9][0-9.]*[0-9]\.tar\.gz' | sed 's/unrarsrc-//; s/\.tar\.gz//' | sort -V | tail -1)
latest_rar2fs=$(curl -fsSL -m 20 https://api.github.com/repos/hasse69/rar2fs/releases/latest 2>/dev/null |
  jq -r '.tag_name // empty' | sed 's/^v//')
dock=$(cat /etc/rar2fs-dock-version 2>/dev/null)
latest_dock=$(curl -fsSL -m 20 https://raw.githubusercontent.com/joshuarcampbell/rar2fs-dock/main/VERSION 2>/dev/null |
  head -1 | grep -x '[0-9][0-9.]*')
latest_rclone=$(curl -fsSL -m 20 https://downloads.rclone.org/version.txt 2>/dev/null |
  sed -n 's/^rclone v\([0-9][0-9.]*\).*/\1/p' | head -1)

{
  echo "checked=$(date +%s)"
  echo "unrar_built=$UNRAR_VERSION";   echo "unrar_latest=$latest_unrar"
  echo "rar2fs_built=$RAR2FS_VERSION"; echo "rar2fs_latest=$latest_rar2fs"
  echo "rclone_built=$VERSION_RCLONE"; echo "rclone_latest=$latest_rclone"
  echo "dock_built=$dock";             echo "dock_latest=$latest_dock"
} > /state/versions.tmp && mv /state/versions.tmp /state/versions

[ -n "$latest_unrar" ]  && newer "$latest_unrar"  "$UNRAR_VERSION"  && echo "unrar $latest_unrar is available (this image has $UNRAR_VERSION)"
[ -n "$latest_rar2fs" ] && newer "$latest_rar2fs" "$RAR2FS_VERSION" && echo "rar2fs $latest_rar2fs is available (this image has $RAR2FS_VERSION)"
[ -n "$latest_rclone" ] && newer "$latest_rclone" "$VERSION_RCLONE" && echo "rclone $latest_rclone is available (this image has $VERSION_RCLONE)"
[ -n "$latest_dock" ]   && newer "$latest_dock"   "$dock"           && echo "rar2fs-dock $latest_dock is available (this setup is $dock; get it with: rar2fs.ps1 update)"
exit 0
