#!/bin/sh
# Looks up the newest unrar and rar2fs releases and records them in /state/versions.
# Prints a line for each one that is newer than what this image was built with.
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

latest_unrar=$(curl -fsSL -m 20 https://www.rarlab.com/rar_add.htm 2>/dev/null |
  grep -o 'unrarsrc-[0-9][0-9.]*[0-9]\.tar\.gz' | sed 's/unrarsrc-//; s/\.tar\.gz//' | sort -V | tail -1)
latest_rar2fs=$(curl -fsSL -m 20 https://api.github.com/repos/hasse69/rar2fs/releases/latest 2>/dev/null |
  jq -r '.tag_name // empty' | sed 's/^v//')

{
  echo "checked=$(date +%s)"
  echo "unrar_built=$UNRAR_VERSION";   echo "unrar_latest=$latest_unrar"
  echo "rar2fs_built=$RAR2FS_VERSION"; echo "rar2fs_latest=$latest_rar2fs"
} > /state/versions.tmp && mv /state/versions.tmp /state/versions

[ -n "$latest_unrar" ]  && newer "$latest_unrar"  "$UNRAR_VERSION"  && echo "unrar $latest_unrar is available (this image has $UNRAR_VERSION)"
[ -n "$latest_rar2fs" ] && newer "$latest_rar2fs" "$RAR2FS_VERSION" && echo "rar2fs $latest_rar2fs is available (this image has $RAR2FS_VERSION)"
exit 0
