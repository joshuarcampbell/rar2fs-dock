#!/bin/sh
# Looks for the usual setup mistakes from inside the container and says, in plain
# words, what is wrong and what to do about it.
#
#   doctor          the quick checks - run with every status page build
#   doctor --full   also asks Plex, Jellyfin and Emby whether their address and token work
#
# One line per finding:   level<TAB>what<TAB>details      (level: ok, warn or bad)
#
# It can only see what the container sees. The mistakes that live in the compose files
# (a network share that is defined but never used, a Windows folder that doesn't exist)
# are checked on the PC, by windows\doctor.ps1 - which also runs this and shows both.
STATE=/tmp/folders.state
EXPECTED=/tmp/mounts.expected
full=0; [ "${1:-}" = "--full" ] && full=1
TAB=$(printf '\t')
say() { printf '%s\t%s\t%s\n' "$1" "$2" "$(printf '%s' "$3" | tr '\t\n' '  ')"; }

# where a folder under /sources really comes from, e.g. H:\Games or //nas/share/TV
origin() {
  awk -v m="$1" '$5 == m {
      for (i = 1; i <= NF; i++) if ($i == "-") { src = $(i + 2); break }
      root = $4
      if (src ~ /^[A-Za-z]:/) { gsub(/\//, "\\", root); p = substr(src, 1, 2) root }
      else                    { p = src (root == "/" ? "" : root) }
      print p; exit }' /proc/self/mountinfo |
    sed 's/[\]040/ /g; s/[\]134/\\/g; s/[\][\]*/\\/g'
}

# ---- is anything shared at all? ----
if [ ! -s "$STATE" ]; then
  say bad "No folders" "Nothing is shared yet. Add your folders to docker-compose.override.yml (or run windows\\setup.ps1), then: docker compose up -d"
fi

# ---- every source folder: readable, and not empty ----
# The folders Docker mounted under /sources, plus the ones named in config/folders.conf.
sources=$( {
    awk 'index($5, "/sources/") == 1 { for (i = 1; i <= NF; i++) if ($i == "-") { print $5 "\t" $(i + 1); break } }' /proc/self/mountinfo
    cut -f2 "$STATE" 2>/dev/null | tr ':' '\n' | grep -v '^/sources/' | sed 's/$/\tconf/'
  } | sort -u)
total=0; wrong=0
while IFS="$TAB" read -r raw type; do
  [ -n "$raw" ] || continue
  path=$(printf '%s' "$raw" | sed 's/[\]040/ /g')
  total=$((total + 1))
  if [ "$type" = conf ]; then from=$path; shown=$path; else from=$(origin "$raw"); shown=${path#/sources/}; fi
  if ! ls -A "$path" > /dev/null 2>&1; then
    wrong=$((wrong + 1))
    say bad "$shown can't be read" "The container is not allowed to look inside $from. For a network share, check that the NAS login (NAS_USER / NAS_PASS in .env) may read that folder."
  elif [ -z "$(ls -A "$path" 2>/dev/null | head -1)" ]; then
    wrong=$((wrong + 1))
    case "$type" in
      cifs|nfs*) say warn "$shown is empty" "The network share $from connected, but there is nothing in it. Check that its \"device\" line points at the folder that holds the files, and that the NAS login may see them." ;;
      conf)      say warn "$shown is empty" "This folder from config/folders.conf has nothing in it. Check the path." ;;
      *)         say warn "$shown is empty" "$from has nothing in it. If it should, check how the path is spelled in docker-compose.override.yml: Docker quietly creates a folder that doesn't exist. A drive letter that Windows mapped to a NAS also shows up empty - connect it as a network share instead (see the README)." ;;
    esac
  fi
done <<EOF
$sources
EOF
[ "$total" -gt 0 ] && [ "$wrong" -eq 0 ] && say ok "Source folders" "All $total can be read and none is empty."

# ---- every folder still mounted ----
if [ -s "$EXPECTED" ]; then
  stopped=""
  while IFS= read -r m; do
    case "$m" in /view/*) ls "$m" > /dev/null 2>&1 || stopped="$stopped ${m#/view/}" ;; esac
  done < "$EXPECTED"
  if [ -n "$stopped" ]; then
    say bad "Stopped:$stopped" "These folders have stopped answering. The container restarts itself after three failed checks; to do it now: docker compose restart"
  else
    say ok "Folders" "All $(grep -c '^/view/' "$EXPECTED") are mounted and answering."
  fi
fi

# ---- config/folders.conf: lines that were skipped ----
if [ -f /config/folders.conf ]; then
  mount-folders plan 2>&1 > /dev/null | sed 's/^mount-folders: folders.conf: //' | while IFS= read -r line; do
    [ -n "$line" ] && say warn "folders.conf" "$line"
  done
fi

# ---- the login ----
if [ "$WEBDAV_PASS" = "change-me" ]; then
  say warn "Password" "WEBDAV_PASS is still the example one. Anyone on your network can open the drive. Change it in .env, then: docker compose up -d"
fi

# ---- the HTTPS certificate ----
if [ "${TLS:-1}" = "1" ] && [ -f /tls/cert.pem ]; then
  ends=$(openssl x509 -in /tls/cert.pem -noout -enddate 2>/dev/null | sed 's/^notAfter=//')
  renew="Delete the tls folder and restart the container to get a new one, then copy tls/cert.pem to the other machines again."
  if ! openssl x509 -in /tls/cert.pem -noout -checkend 0 > /dev/null 2>&1; then
    say bad "HTTPS certificate" "It ran out on $ends, so other machines will refuse to connect. $renew"
  elif ! openssl x509 -in /tls/cert.pem -noout -checkend 2592000 > /dev/null 2>&1; then
    say warn "HTTPS certificate" "It runs out on $ends. $renew"
  else
    say ok "HTTPS certificate" "Good until $ends."
  fi
fi

# ---- media servers: instant refresh for Plex, Jellyfin and Emby ----
# name, address, token or key, path map
check_server() {
  name=$1; url=${2%/}; secret=$3; map=$4
  [ -n "$url" ] && [ -n "$secret" ] || return 0
  what="$name refresh"; wrong=0
  if [ -z "$map" ]; then
    wrong=1
    say warn "$what" "Its path map is empty, so $name can't be told which of its folders changed. Set it in .env (see the README)."
  else
    for folder in $(printf '%s' "$map" | tr ';' '\n' | sed -n 's/^[[:space:]]*\([^=/]*\).*=.*/\1/p' | sort -u); do
      cut -f1 "$STATE" 2>/dev/null | grep -qxF "$folder" && continue
      wrong=1
      say warn "$what" "Its path map mentions \"$folder\", but no shared folder has that name. Shared: $(cut -f1 "$STATE" 2>/dev/null | tr '\n' ' ')"
    done
  fi
  if [ "$full" = 1 ]; then
    # the token or key goes in on stdin, so it never shows in a process list
    case "$name" in
      Plex)     code=$(printf 'header = "X-Plex-Token: %s"\n' "$secret" | curl -sk -m 6 -o /dev/null -w '%{http_code}' -K - "$url/library/sections" 2>/dev/null) ;;
      Jellyfin) code=$(printf 'header = "Authorization: MediaBrowser Token=\\"%s\\""\n' "$secret" | curl -sk -m 6 -o /dev/null -w '%{http_code}' -K - "$url/System/Info" 2>/dev/null) ;;
      Emby)     code=$(printf 'header = "X-Emby-Token: %s"\n' "$secret" | curl -sk -m 6 -o /dev/null -w '%{http_code}' -K - "$url/emby/System/Info" 2>/dev/null) ;;
    esac
    case "$code" in
      200) [ "$wrong" = 0 ] && say ok "$what" "$name answers at $url and accepts the token." ;;
      401|403) say bad "$what" "$name answers at $url but turned down its token or key. Get a fresh one (see the README) and put it in .env." ;;
      000) say bad "$what" "Nothing answers at $url. Check the address, and that $name is running and reachable from this PC." ;;
      *)   say warn "$what" "$name at $url answered with code $code, not the expected 200." ;;
    esac
  elif [ "$wrong" = 0 ]; then
    say ok "$what" "On, for: $(printf '%s' "$map" | tr ';' '\n' | sed -n 's/^[[:space:]]*\([^=]*\)=.*/\1/p' | tr '\n' ' ')"
  fi
}
check_server Plex     "$PLEX_URL"     "$PLEX_TOKEN"       "$PLEX_PATH_MAP"
check_server Jellyfin "$JELLYFIN_URL" "$JELLYFIN_API_KEY" "$JELLYFIN_PATH_MAP"
check_server Emby     "$EMBY_URL"     "$EMBY_API_KEY"     "$EMBY_PATH_MAP"

# ---- archive passwords (config/passwords.conf) ----
if [ -f /config/passwords.conf ]; then
  if [ -s /tmp/passwords.problems ]; then
    while IFS= read -r line; do say warn "passwords.conf" "$line"; done < /tmp/passwords.problems
  fi
  n=$(grep -c '^\[' /tmp/rarconfig 2>/dev/null || echo 0)
  [ "$n" -gt 0 ] && say ok "Archive passwords" "$n archive(s) have a password."
fi
exit 0
