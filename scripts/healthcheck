#!/bin/sh
# Healthy = every /view/<name> is a live rar2fs mount that can be listed,
# and the WebDAV server answers (401 = up, asking for a login).
for d in /view/*/; do
  [ -d "$d" ] || continue
  mountpoint -q "$d" || { echo "$d is not mounted"; exit 1; }
  ls "$d" > /dev/null 2>&1 || { echo "$d cannot be listed"; exit 1; }
done
code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' http://127.0.0.1:8080/)
[ "$code" = "401" ] || [ "$code" = "200" ] || { echo "WebDAV answered $code"; exit 1; }
if [ "${SHORT_PATHS:-0}" = "1" ]; then
  mountpoint -q /short && ls /short > /dev/null 2>&1 || { echo "the short-names view is not mounted"; exit 1; }
  code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' http://127.0.0.1:8082/)
  [ "$code" = "401" ] || [ "$code" = "200" ] || { echo "short-names server answered $code"; exit 1; }
fi
echo ok
