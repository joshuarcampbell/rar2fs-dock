#!/bin/sh
# Writes /state/www/status.html - a snapshot of what the container is doing.
# Rebuilt every minute by `monitor`, and by status-server whenever someone is looking at
# it (the page fetches a fresh copy of itself every few seconds - see page.js).
# Served on port 8081 with the same logins as the drive.
out=/state/www/status.html
esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g; s/'"'"'/\&#39;/g'; }
when() { printf '<time data-t="%s"></time>' "$1"; }   # shown in the viewer's local time
val() { sed -n "s/^$1=//p" /state/versions 2>/dev/null; }
TAB=$(printf '\t')

# where a /sources folder really comes from, e.g. H:\Games or //nas/share/TV
origin() {
  awk -v m="$1" '$5 == m {
      for (i = 1; i <= NF; i++) if ($i == "-") { src = $(i + 2); break }
      root = $4
      if (src ~ /^[A-Za-z]:/) { gsub(/\//, "\\", root); p = substr(src, 1, 2) root }
      else if (src ~ /^\/\// || src ~ /:/) { p = src (root == "/" ? "" : root) }   # a share: //nas/share, host:/export
      else                    { p = root }      # a folder on a Linux host: its path (the name of the disk says nothing)
      print p; exit }' /proc/self/mountinfo |
    sed 's/[\]040/ /g; s/[\]134/\\/g; s/[\][\]*/\\/g'   # mountinfo writes space as \040, backslash as \134
}

health=$(cut -f1 /state/health 2>/dev/null); detail=$(cut -s -f2- /state/health 2>/dev/null)
case "$health" in
  healthy)   badge=ok;   label="Healthy" ;;
  unhealthy) badge=bad;  label="Unhealthy" ;;
  *)         badge="wait"; label="Starting" ;;
esac

{
cat <<HTML
<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<noscript><meta http-equiv="refresh" content="60"></noscript><title>rar2fs-dock status</title>
<style>
$(cat /usr/local/bin/page.css)
</style></head><body><p id="lost" hidden></p><main>
<h1>rar2fs-dock <span class="badge $badge">$label</span></h1>
<p class="sub">Started $(when "$(cat /state/started 2>/dev/null)") · live, last updated $(when "$(date +%s)")$( [ -n "$detail" ] && printf ' · %s' "$(printf '%s' "$detail" | esc)")</p>
<form method="get" action="search" class="run" style="margin:0 0 16px"><input type="search" name="q" placeholder="Search the library by name" required> <button type="submit">Search</button></form>

<section><h2>Folders</h2><table>
<tr><th>Folder</th><th>Comes from</th><th>Status</th><th style="text-align:right">Items</th></tr>
HTML
# the folders that should exist, whether or not they are still alive
folders=$(sed -n 's|^/view/||p' /tmp/mounts.expected 2>/dev/null)
for name in $folders; do
  d="/view/$name"
  if ls "$d" > /dev/null 2>&1; then st='<span class="badge ok">mounted</span>'; n=$(ls -1A "$d" 2>/dev/null | wc -l); elif mount-alive "$d"; then st='<span class="badge wait">no access</span>'; n='-'; else st='<span class="badge bad">stopped</span>'; n='-'; fi
  from=$(awk -v a="/sources/$name" '$5 == a || index($5, a "/") == 1 || index($5, a "@") == 1 {print $5}' /proc/self/mountinfo | sort -u |
    while IFS= read -r m; do
      rel=${m#/sources/$name}; rel=${rel#@*}
      case "$m" in "/sources/$name@"*) rel="" ;; esac
      printf '%s%s<br>' "$( [ -n "$rel" ] && printf '<span class="dim">%s:</span> ' "$(printf '%s' "${rel#/}" | esc)")" "$(origin "$m" | esc)"
    done)
  printf '<tr><td><code>%s</code></td><td>%s</td><td>%s</td><td class="n">%s</td></tr>\n' "$(printf '%s' "$name" | esc)" "$from" "$st" "$n"
done
echo '</table></section>'

# what is being read right now (from `activity`, which rewrites the file every 2 seconds)
echo '<section><h2>In use now</h2>'
act=/tmp/activity.json
if [ -s "$act" ] && [ $(( $(date +%s) - $(jq -r '.updated // 0' "$act" 2>/dev/null || echo 0) )) -lt 30 ]; then
  jq -r '
    def speed: if . >= 1048576 then "\((. / 104857.6 | round) / 10) MB/s"
               elif . >= 1024 then "\(. / 1024 | round) KB/s"
               elif . > 0 then "\(.) B/s" else "-" end;
    def who: ((.users | join(", ")) | @html) + " <span class=\"dim\">" + ((.clients | join(", ")) | @html) + "</span>";
    (if (.reading | length) == 0 then "<p class=\"none\">Nothing is being read right now.</p>"
     else
       "<table><tr><th>File</th><th>Who</th><th style=\"text-align:right\">Progress</th><th style=\"text-align:right\">Speed</th></tr>",
       (.reading[] | "<tr><td>\(.path | @html)\(if .short_names then " <span class=\"dim\">(short-names view)</span>" else "" end)</td>"
          + "<td>\(who)</td><td class=\"n\">\(if .percent == null then "-" else "\(.percent)%" end)</td>"
          + "<td class=\"n\">\(.bytes_per_second | speed)</td></tr>"),
       "</table>"
     end),
    (if (.browsing | length) > 0 then
       "<p class=\"sub\" style=\"margin:10px 0 0\">Browsing or scanning: "
       + (.browsing | map("\(.user | @html) <span class=\"dim\">\(.client | @html)</span> - \(.listings_last_minute) folder listings in the last minute") | join("; "))
       + "</p>"
     else empty end)
  ' "$act"
else
  echo '<p class="none">Not available yet.</p>'
fi
echo '</section>'

# what `doctor` found: problems first, then one line for everything that passed
doctor > /state/doctor.tsv.$$.tmp 2>/dev/null && mv /state/doctor.tsv.$$.tmp /state/doctor.tsv
echo '<section><h2>Setup check</h2>'
if grep -qv "^ok$TAB" /state/doctor.tsv 2>/dev/null; then
  echo '<table>'
  grep -v "^ok$TAB" /state/doctor.tsv | sort | while IFS="$TAB" read -r level title msg; do
    [ "$level" = bad ] && b='<span class="badge bad">problem</span>' || b='<span class="badge wait">check</span>'
    printf '<tr><td>%s</td><td><b>%s</b><br>%s</td></tr>\n' "$b" "$(printf '%s' "$title" | esc)" "$(printf '%s' "$msg" | esc)"
  done
  echo '</table>'
else
  echo '<p><span class="badge ok">all good</span> Nothing looks wrong from inside the container.</p>'
fi
passed=$(grep "^ok$TAB" /state/doctor.tsv 2>/dev/null | cut -f2 | esc | sed 's/$/ · /' | tr -d '\n' | sed 's/ · $//')
echo "<p class=\"sub\" style=\"margin:10px 0 0\">$( [ -n "$passed" ] && printf 'Passed: %s. ' "$passed")For the checks that need your compose files, run <code>windows/doctor.ps1</code> on the PC.</p></section>"

library-html 2>/dev/null       # overview, recently added, duplicates

echo '<section><h2>Versions</h2><table><tr><th>Component</th><th>In this image</th><th>Latest</th><th></th></tr>'
for c in unrar rar2fs; do
  # "In this image" comes from the running image itself, never from the saved check
  if [ "$c" = unrar ]; then b=$UNRAR_VERSION; else b=$RAR2FS_VERSION; fi
  l=$(val "${c}_latest")
  if [ -z "$l" ]; then note='<span class="dim">not checked yet</span>'
  elif [ "$b" = "$l" ] || [ "$(printf '%s\n%s\n' "$b" "$l" | sort -V | tail -1)" = "$b" ]; then note='<span class="badge ok">up to date</span>'
  else note='<span class="badge wait">update available</span>'; fi
  printf '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' "$c" "${b:-?}" "${l:--}" "$note"
done
c=$(val checked); echo "</table><p class=\"sub\" style=\"margin:10px 0 0\">$( [ -n "$c" ] && printf 'Last checked %s' "$(when "$c")" || echo 'Checked once a day.')</p></section>"

echo '<section><h2>Health report</h2>'
if [ -f /state/report.running ]; then
  IFS="$(printf '\t')" read -r started scope < /state/report.running
  echo "<p><span class=\"badge wait\">running</span> Checking <b>$(printf '%s' "$scope" | esc)</b>, started $(when "$started"). This page shows the result when it finishes.</p>"
fi
if [ -f /state/www/health-report.txt ]; then
  scope=$(sed -n '1s/^Health report for: //p' /state/www/health-report.txt)
  echo "<p>Last report: <b>$(printf '%s' "${scope:-everything}" | esc)</b>, finished $(when "$(stat -c %Y /state/www/health-report.txt)") · <a href=\"problems\">review the problems</a> · <a href=\"health-report.txt\">full report</a></p><table>"
  # problems you marked "ignore" on the problems list are left out of the counts
  report-counts | while IFS="$TAB" read -r kind shown ignored; do
    printf '<tr><td>%s</td><td class="n">%s%s</td></tr>\n' "$(printf '%s' "$kind" | esc)" "$shown" \
      "$( [ "$ignored" -gt 0 ] && printf ' <span class="dim">(+%s ignored)</span>' "$ignored")"
  done
  echo '</table>'
elif [ ! -f /state/report.running ]; then
  echo '<p class="none">No report yet.</p>'
fi
# the button: everything, a folder, or one of the sub-folders a folder is made of
echo '<form method="post" action="run-report" class="run"><label for="folder">Check</label> <select name="folder" id="folder"><option value="">Everything</option>'
for name in $folders; do
  ls "/view/$name" > /dev/null 2>&1 || continue      # a stopped folder can't be checked
  printf '<option value="%s">%s</option>\n' "$(printf '%s' "$name" | esc)" "$(printf '%s' "$name" | esc)"
  awk -v a="/sources/$name/" 'index($5, a) == 1 { s = substr($5, length(a) + 1); if (s !~ /\//) print s }' /proc/self/mountinfo | sort -u |
    while IFS= read -r sub; do
      printf '<option value="%s">&nbsp;&nbsp;%s</option>\n' "$(printf '%s/%s' "$name" "$sub" | esc)" "$(printf '%s/%s' "$name" "$sub" | esc)"
    done
done
if [ -f /state/report.running ]; then
  echo '</select> <button type="submit" disabled>Report running…</button></form>'
else
  echo '</select> <button type="submit">Run health report</button></form>'
fi
echo "<p class=\"sub\" style=\"margin:10px 0 0\">A full report also runs by itself every ${HEALTH_REPORT_DAYS:-7} days. Checking everything can take a while; a single folder is much quicker.</p>"
echo '</section>'

echo '<section><h2>Recent events</h2>'
if [ -s /state/events.log ]; then
  echo '<table><tr><th>When</th><th>Event</th><th>Details</th></tr>'
  tail -n 25 /state/events.log | sort -rn | while IFS="$(printf '\t')" read -r t title msg; do
    printf '<tr><td style="white-space:nowrap">%s</td><td>%s</td><td>%s</td></tr>\n' "$(when "$t")" "$(printf '%s' "$title" | esc)" "$(printf '%s' "$msg" | esc)"
  done
  echo '</table>'
else echo '<p class="none">Nothing yet. Restarts, media-server scans, updates and report findings show up here.</p>'; fi
echo '</section>'
# ---- settings: a summary, then every setting with its value and whether it was changed ----
onoff() { [ "$1" = "$2" ] && echo on || echo off; }
media_servers=$( { [ -n "$PLEX_URL" ] && [ -n "$PLEX_TOKEN" ] && printf 'Plex · %s\n' "$PLEX_URL"
                   [ -n "$JELLYFIN_URL" ] && [ -n "$JELLYFIN_API_KEY" ] && printf 'Jellyfin · %s\n' "$JELLYFIN_URL"
                   [ -n "$EMBY_URL" ] && [ -n "$EMBY_API_KEY" ] && printf 'Emby · %s\n' "$EMBY_URL"; } | esc | sed 's/$/<br>/')
cat <<HTML
<section><h2>Settings</h2><table>
<tr><td>Instant refresh</td><td>${media_servers:-off (no media server set up)}</td></tr>
<tr><td>Heartbeat</td><td>$( [ -n "$HEARTBEAT_URL" ] && echo on || echo 'off (no HEARTBEAT_URL)')</td></tr>
<tr><td>Notifications</td><td>$( [ -n "$NOTIFY_URL" ] && echo on || echo 'off (no NOTIFY_URL)')</td></tr>
<tr><td>Automatic restart</td><td>$(onoff "${AUTO_RESTART:-1}" 1)</td></tr>
<tr><td>Archives inside archives</td><td>$(onoff "${NESTED_RAR:-1}" 1)</td></tr>
<tr><td>Archive passwords</td><td>$( [ -s /tmp/rarconfig ] && echo "$(grep -c '^\[' /tmp/rarconfig) archive(s) have one" || echo 'none (no config/passwords.conf)')</td></tr>
<tr><td>Short names view</td><td>$( [ "${SHORT_PATHS:-0}" = 1 ] && echo "on · port 8767 · paths up to ${MAX_PATH:-230} characters" || echo off)</td></tr>
<tr><td>HTTPS</td><td>$(onoff "${TLS:-1}" 1)</td></tr>
<tr><td>Logins</td><td>$(cut -d: -f1 /tmp/htpasswd 2>/dev/null | esc | tr '\n' ' ')</td></tr>
</table>
<h2 style="margin-top:16px">Every setting</h2>
<p class="sub" style="margin:0 0 10px">All of these are set in <code>.env</code>, followed by <code>docker compose up -d</code>. Passwords, tokens and addresses that contain one are not shown.</p>
<table class="settings"><tr><th>Setting</th><th>Value now</th><th>What it does</th></tr>
HTML
# name, value now, default, what it does
setting() {
  if [ "$2" = "$3" ]; then state='<span class="dim">default</span>'; else state='<b>changed</b>'; fi
  printf '<tr><td><code>%s</code></td><td><code>%s</code><br>%s</td><td class="dim">%s</td></tr>\n' \
    "$1" "$(printf '%s' "${2:-(empty)}" | esc)" "$state" "$4"
}
hidden() { [ -n "$1" ] && echo '(set - hidden)'; }      # for values that are secrets
default_hide='*.sfv;Thumbs.db;desktop.ini;.DS_Store;@Recycle/**;.qsyncclient/**;Sample/**;Proof/**'
setting TLS                   "${TLS:-1}"                     1          'HTTPS for the drive and this page; 0 = plain HTTP'
setting TLS_HOSTS             "$TLS_HOSTS"                    ''         'Addresses or names other devices use for this PC (they go in the certificate)'
setting SHORT_PATHS           "${SHORT_PATHS:-0}"             0          'A second view on port 8767 with names shortened to fit Windows'
setting MAX_PATH              "${MAX_PATH:-230}"              230        'Longest path allowed in the short-names view'
setting NESTED_RAR            "${NESTED_RAR:-1}"              1          'Open archives inside archives (subtitle packs)'
setting HIDE                  "$HIDE"                         "$default_hide" 'Files and folders left out of the drive, ;-separated'
setting RAR2FS_OPTS           "$RAR2FS_OPTS"                  '--seek-length=1 -o warmup' 'Options passed to rar2fs'
setting DIR_CACHE_TIME        "${DIR_CACHE_TIME:-15s}"        15s        'How long the drive remembers a folder listing'
setting RCLONE_OPTS           "$RCLONE_OPTS"                  ''         'Extra options for the WebDAV server'
setting LOGIN_GUESS_LIMIT     "${LOGIN_GUESS_LIMIT:-5}"       5          'Wrong logins allowed in 10 seconds before new logins are refused'
setting AUTO_RESTART          "${AUTO_RESTART:-1}"            1          'Restart after three failed health checks'
setting HEALTH_REPORT_DAYS    "${HEALTH_REPORT_DAYS:-7}"      7          'Days between scheduled health reports; 0 = never'
setting CPU_LIMIT             "${CPU_LIMIT:-0}"               0          'Most processor cores the container may use; 0 = no limit'
setting MEMORY_LIMIT          "${MEMORY_LIMIT:-0}"            0          'Most memory the container may use, e.g. 4g; 0 = no limit'
setting LIBRARY_INDEX_MINUTES "${LIBRARY_INDEX_MINUTES:-10}"  10        'Minutes between rebuilds of the search and duplicates index'
setting NOTIFY_URL            "$(hidden "$NOTIFY_URL")"       ''         'Where alerts are sent'
setting HEARTBEAT_URL         "$(hidden "$HEARTBEAT_URL")"    ''         'A URL pinged every minute while healthy'
setting STATUS_TOKEN          "$(hidden "$STATUS_TOKEN")"     ''         'Read-only token for status.json, /metrics and the RSS feed'
setting PLEX_URL              "$PLEX_URL"                     ''         'Plex: where it answers'
setting PLEX_TOKEN            "$(hidden "$PLEX_TOKEN")"       ''         'Plex: its token'
setting PLEX_PATH_MAP         "$PLEX_PATH_MAP"                ''         'Plex: where each folder is on the Plex machine'
setting PLEX_SHORT_NAMES      "${PLEX_SHORT_NAMES:-auto}"     auto       'Plex: whether it sees the shortened names'
setting JELLYFIN_URL          "$JELLYFIN_URL"                 ''         'Jellyfin: where it answers'
setting JELLYFIN_API_KEY      "$(hidden "$JELLYFIN_API_KEY")" ''         'Jellyfin: an API key'
setting JELLYFIN_PATH_MAP     "$JELLYFIN_PATH_MAP"            ''         'Jellyfin: where each folder is on that machine'
setting JELLYFIN_SHORT_NAMES  "${JELLYFIN_SHORT_NAMES:-auto}" auto       'Jellyfin: whether it sees the shortened names'
setting EMBY_URL              "$EMBY_URL"                     ''         'Emby: where it answers'
setting EMBY_API_KEY          "$(hidden "$EMBY_API_KEY")"     ''         'Emby: an API key'
setting EMBY_PATH_MAP         "$EMBY_PATH_MAP"                ''         'Emby: where each folder is on that machine'
setting EMBY_SHORT_NAMES      "${EMBY_SHORT_NAMES:-auto}"     auto       'Emby: whether it sees the shortened names'
setting PLEX_POLL_SECONDS     "${PLEX_POLL_SECONDS:-60}"      60         'Media servers: seconds between looks for changes'
setting PLEX_SETTLE_SECONDS   "${PLEX_SETTLE_SECONDS:-90}"    90         'Media servers: seconds to wait after the last change'
setting PLEX_WATCH_DEPTH      "${PLEX_WATCH_DEPTH:-4}"        4          'Media servers: how many folder levels are watched'
cat <<HTML
</table>
<p class="sub" style="margin:10px 0 0">Not visible from inside the container, so not listed: <code>WEBDAV_USER</code> / <code>WEBDAV_PASS</code> (see Logins above), <code>BIND</code>, <code>NAS_USER</code> / <code>NAS_PASS</code> and <code>APPARMOR_PROFILE</code>. Your folders are in <code>docker-compose.override.yml</code>.</p>
</section>
</main>
<script>
$(cat /usr/local/bin/page.js)
</script></body></html>
HTML
} > "$out.$$.tmp" && mv "$out.$$.tmp" "$out"     # own temp file: several can run at once

status-data 2>/dev/null || true                  # same data as status.json and /metrics
