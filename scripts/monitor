#!/bin/sh
# Background watchdog, started by the entrypoint.
#   - runs the health check every minute; after 3 failures in a row it restarts the
#     container (AUTO_RESTART=0 turns that off). Gives up after 3 restarts in an hour.
#   - checks daily for newer unrar / rar2fs releases
#   - runs the health report every HEALTH_REPORT_DAYS days (0 = never)
#   - rebuilds the status page every minute
# Anything worth knowing goes through `notify`.

INTERVAL=${MONITOR_INTERVAL:-60}
REPORT_DAYS=${HEALTH_REPORT_DAYS:-7}
mkdir -p /state/www
export LC_ALL=C
rm -f /state/report.running
now() { date +%s; }
age() { [ -f "$1" ] && echo $(( $(now) - $(stat -c %Y "$1") )) || echo 999999999; }

date +%s > /state/started
echo starting > /state/health
fails=0

while sleep "$INTERVAL"; do
  # ---- health ----
  if out=$(healthcheck 2>&1); then
    if [ -f /state/restart-pending ]; then
      notify "Recovered" "The container is healthy again after an automatic restart."
      rm -f /state/restart-pending
    elif [ "$fails" -ge 3 ]; then
      notify "Recovered" "The container is healthy again."
    fi
    fails=0; echo healthy > /state/health
  else
    fails=$((fails + 1)); printf 'unhealthy\t%s\n' "$out" > /state/health
    if [ "$fails" -eq 3 ]; then
      # restarts in the last hour
      touch /state/restarts
      awk -v t="$(( $(now) - 3600 ))" '$1 > t' /state/restarts > /state/restarts.tmp; mv /state/restarts.tmp /state/restarts
      recent=$(wc -l < /state/restarts)
      if [ "${AUTO_RESTART:-1}" != "1" ]; then
        notify "Unhealthy" "$out. Automatic restart is off - run: docker compose restart"
      elif [ "$recent" -ge 3 ]; then
        notify "Still unhealthy" "$out. Restarted $recent times in the last hour without fixing it, so it needs a look. Not restarting again."
      else
        now >> /state/restarts; touch /state/restart-pending
        notify "Unhealthy - restarting" "$out"
        status-page 2>/dev/null
        kill -TERM 1
        exit 0
      fi
    fi
  fi

  # ---- daily: newer unrar / rar2fs? ----
  if [ "$(age /state/versions)" -gt 86400 ]; then
    found=$(update-check)
    if [ -n "$found" ] && [ "$found" != "$(cat /state/versions.notified 2>/dev/null)" ]; then
      notify "Update available" "$found. Change the version and SHA-256 in the Dockerfile, then: docker compose up -d --build"
      printf '%s' "$found" > /state/versions.notified
    fi
  fi

  # ---- every REPORT_DAYS: health report, in the background ----
  if [ "$REPORT_DAYS" -gt 0 ] && [ ! -f /state/report.running ] \
     && [ "$(age /state/www/health-report.txt)" -gt $((REPORT_DAYS * 86400)) ] \
     && [ $(( $(now) - $(cat /state/started) )) -gt "${HEALTH_REPORT_DELAY:-3600}" ]; then
    (
      touch /state/report.running
      nice -n 19 health-report > /state/report.tmp 2>&1
      grep '^  ' /state/report.tmp | sort > /state/report.problems.new
      new=$(comm -13 /state/report.problems /state/report.problems.new 2>/dev/null || cat /state/report.problems.new)
      mv /state/report.problems.new /state/report.problems
      mv /state/report.tmp /state/www/health-report.txt
      if [ -n "$new" ]; then
        notify "Health report: $(printf '%s\n' "$new" | wc -l) new problem(s)" "$(printf '%s\n' "$new" | head -10 | sed 's/^  //')
Full report: docker exec rar2fs cat /state/www/health-report.txt"
      fi
      rm -f /state/report.running
    ) &
  fi

  status-page 2>/dev/null
done
