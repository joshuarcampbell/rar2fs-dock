#!/bin/sh
# Background watchdog, started by the entrypoint.
#   - runs the health check every minute; after 3 failures in a row it restarts the
#     container (AUTO_RESTART=0 turns that off). Gives up after 3 restarts in an hour.
#   - checks daily for newer unrar / rar2fs releases
#   - runs the health report every HEALTH_REPORT_DAYS days (0 = never)
#   - rebuilds the status page every minute
#   - if HEARTBEAT_URL is set, pings it every minute while healthy (see heartbeat below)
# Anything worth knowing goes through `notify`.

INTERVAL=${MONITOR_INTERVAL:-60}
REPORT_DAYS=${HEALTH_REPORT_DAYS:-7}
mkdir -p /state/www
export LC_ALL=C
rm -f /state/report.running
# The saved update check belongs to the image that made it. After a rebuild with other
# versions, throw it away so the check runs again on the first pass.
saved() { sed -n "s/^$1=//p" /state/versions 2>/dev/null; }
if [ "$(saved unrar_built)" != "$UNRAR_VERSION" ] || [ "$(saved rar2fs_built)" != "$RAR2FS_VERSION" ]; then
  rm -f /state/versions /state/versions.notified
fi
# upgrading from a version that timed the schedule by the report file itself
[ -f /state/report.full ] || { [ -f /state/www/health-report.txt ] && touch -r /state/www/health-report.txt /state/report.full; }
now() { date +%s; }
age() { [ -f "$1" ] && echo $(( $(now) - $(stat -c %Y "$1") )) || echo 999999999; }

# Heartbeat: an outside service (Uptime Kuma, Healthchecks.io ...) expects a ping every
# minute and raises the alarm when the pings stop - which also covers this PC being off
# or Docker not running, something nothing inside the container can report.
heartbeat() {  # up|down, message
  [ -n "$HEARTBEAT_URL" ] || return 0
  url=$HEARTBEAT_URL
  cfg=$(mktemp)                              # the URL holds a secret: keep it off the command line
  if [ "$1" = up ]; then
    printf 'url = "%s"\n' "$url" > "$cfg"
    curl -fsS -m 10 -o /dev/null -K "$cfg" 2>/dev/null || true
  else
    case "$url" in
      *status=up*)                           # Uptime Kuma push: report "down" with the reason
        url=$(printf '%s' "$url" | sed 's/status=up/status=down/; s/\([?&]\)msg=[^&]*&\{0,1\}/\1/; s/[?&]$//')
        printf 'url = "%s"\n' "$url" > "$cfg"
        curl -fsS -m 10 -o /dev/null -G --data-urlencode "msg=$2" -K "$cfg" 2>/dev/null || true ;;
      *hc-ping.com/*|*/ping/*)               # Healthchecks.io: its /fail address
        printf 'url = "%s"\n' "${url%/}/fail" > "$cfg"
        curl -fsS -m 10 -o /dev/null --data-raw "$2" -K "$cfg" 2>/dev/null || true ;;
      *) ;;                                  # anything else: the missing ping is the signal
    esac
  fi
  rm -f "$cfg"
}

date +%s > /state/started
echo starting > /state/health
fails=0

while sleep "$INTERVAL"; do
  # ---- health ----
  if out=$(healthcheck 2>&1); then
    if [ -f /state/restart-pending ]; then
      notify "Recovered" "The container is healthy again after an automatic restart."
      rm -f /state/restart-pending
    elif [ "$fails" -ge 3 ]; then
      notify "Recovered" "The container is healthy again."
    fi
    fails=0; echo healthy > /state/health
    heartbeat up OK
  else
    fails=$((fails + 1)); printf 'unhealthy\t%s\n' "$out" > /state/health
    heartbeat down "$out"
    if [ "$fails" -eq 3 ]; then
      # restarts in the last hour
      touch /state/restarts
      awk -v t="$(( $(now) - 3600 ))" '$1 > t' /state/restarts > /state/restarts.tmp; mv /state/restarts.tmp /state/restarts
      recent=$(wc -l < /state/restarts)
      if [ "${AUTO_RESTART:-1}" != "1" ]; then
        notify "Unhealthy" "$out. Automatic restart is off - run: docker compose restart"
      elif [ "$recent" -ge 3 ]; then
        notify "Still unhealthy" "$out. Restarted $recent times in the last hour without fixing it, so it needs a look. Not restarting again."
      else
        now >> /state/restarts; touch /state/restart-pending
        notify "Unhealthy - restarting" "$out"
        status-page 2>/dev/null
        kill -TERM 1
        exit 0
      fi
    fi
  fi

  # ---- the status page's own server: restart just that if it stops answering ----
  # (It isn't part of the health check: a stuck status page is no reason to restart
  # the drive under Plex.)
  if [ "${TLS:-1}" = "1" ]; then page=https; else page=http; fi
  code=$(curl -sk -o /dev/null -m 8 -w '%{http_code}' "$page://127.0.0.1:8081/")
  if [ "$code" = "401" ] || [ "$code" = "200" ] || [ "$code" = "302" ]; then
    page_fails=0
  else
    page_fails=$(( ${page_fails:-0} + 1 ))
    if [ "$page_fails" -ge 2 ]; then
      for p in /proc/[0-9]*; do
        [ "$(cat "$p/comm" 2>/dev/null)" = "python3" ] && grep -q status-server "$p/cmdline" 2>/dev/null && kill -9 "${p#/proc/}"
      done
      status-server &
      notify "Status page restarted" "The status page stopped answering and was restarted. The drive was not affected."
      page_fails=0
    fi
  fi

  # ---- daily: newer unrar / rar2fs? ----
  if [ "$(age /state/versions)" -gt 86400 ]; then
    found=$(update-check)
    if [ -n "$found" ] && [ "$found" != "$(cat /state/versions.notified 2>/dev/null)" ]; then
      notify "Update available" "$found. Change the version and SHA-256 in the Dockerfile, then: docker compose up -d --build"
      printf '%s' "$found" > /state/versions.notified
    fi
  fi

  # ---- every REPORT_DAYS: a full health report, in the background ----
  # (timed from the last full report; one started from the status page counts too)
  if [ "$REPORT_DAYS" -gt 0 ] && [ ! -f /state/report.running ] \
     && [ "$(age /state/report.full)" -gt $((REPORT_DAYS * 86400)) ] \
     && [ $(( $(now) - $(cat /state/started) )) -gt "${HEALTH_REPORT_DELAY:-3600}" ]; then
    run-health-report --notify > /dev/null 2>&1 &
  fi

  status-page 2>/dev/null
done
