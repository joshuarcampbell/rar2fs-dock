#!/bin/sh
# Watches the source folders and asks Plex to scan just the folder that changed.
# Started by the entrypoint when PLEX_URL and PLEX_TOKEN are set.
#
#   PLEX_URL            e.g. http://192.168.1.20:32400, or for Plex on this same PC
#                       http://host.docker.internal:32400
#   PLEX_TOKEN          your X-Plex-Token
#   PLEX_PATH_MAP       where each folder is mounted on the Plex server, ;-separated:
#                       tv=/mnt/media/tv;films=/mnt/media/films      (Plex on Linux)
#                       tv=Y:\tv;films=Y:\films                      (Plex on Windows)
#   PLEX_SHORT_NAMES    whether Plex sees the shortened names of the short-names view:
#                       auto (default) = yes for Windows paths when SHORT_PATHS=1,
#                       1 = always, 0 = never
#   PLEX_POLL_SECONDS   how often to look for changes (default 60)
#   PLEX_SETTLE_SECONDS wait after the last change before scanning (default 90)
#   PLEX_WATCH_DEPTH    how many folder levels to watch (default 4)

POLL=${PLEX_POLL_SECONDS:-60}
SETTLE=${PLEX_SETTLE_SECONDS:-90}
DEPTH=${PLEX_WATCH_DEPTH:-4}
dir=$(mktemp -d)
export LC_ALL=C     # comm needs byte-order sorting
log() { echo "plex-refresh: $*"; }

snapshot() {
  find /sources -mindepth 1 -maxdepth "$DEPTH" \
    \( -name '@Recycle' -o -name '.qsyncclient' \) -prune -o -type d -printf '%T@\t%p\n' 2>/dev/null | sort
}

plex() {  # path-and-query, extra curl args...
  url="$PLEX_URL$1"; shift
  printf 'header = "X-Plex-Token: %s"\nheader = "Accept: application/json"\n' "$PLEX_TOKEN" |
    curl -fsS -m 20 -K - "$@" "$url"
}

# /sources/tv@e/Show -> tv/Show -> /mnt/media/tv/Show or Y:\tv\Show (via PLEX_PATH_MAP)
plex_path() {
  rel=${1#/sources/}; top=${rel%%/*}; rel="${top%%@*}${rel#"$top"}"
  best=""; target=""
  old_ifs=$IFS; IFS=';'
  for pair in $PLEX_PATH_MAP; do
    k=${pair%%=*}; v=${pair#*=}
    case "$rel/" in
      "$k"/*) [ ${#k} -gt ${#best} ] && { best=$k; target=$v; } ;;
    esac
  done
  IFS=$old_ifs
  [ -n "$best" ] || return 0

  windows=0
  case "$target" in [A-Za-z]:*|\\\\*) windows=1 ;; esac
  # Y:/tv works as well as Y:\tv
  [ "$windows" = 1 ] && target=$(printf '%s' "$target" | tr '/' '\\')

  # Plex on the short-names view sees shortened folder names, so ask for those
  short=${PLEX_SHORT_NAMES:-auto}
  [ "$short" = "auto" ] && { [ "$windows" = 1 ] && [ "${SHORT_PATHS:-0}" = "1" ] && short=1 || short=0; }
  if [ "$short" = "1" ]; then
    shown=$(shortfs /view --show "$rel" --max-path "${MAX_PATH:-230}" 2>/dev/null) && [ -n "$shown" ] && rel=$shown
  fi

  rest=${rel#"$best"}
  [ "$windows" = 1 ] && rest=$(printf '%s' "$rest" | tr '/' '\\')
  printf '%s' "$target$rest"
}

scan() {  # source path
  p=$(plex_path "$1")
  [ -n "$p" ] || { log "no PLEX_PATH_MAP entry covers ${1#/sources/} - skipped"; return; }
  # Compare with / separators; Windows paths also ignore upper/lower case
  key=$(jq -r --arg p "$p" '
    ($p | test("^[A-Za-z]:|\\\\")) as $win
    | def norm: (if $win then ascii_downcase else . end) | gsub("\\\\"; "/") | sub("/+$"; "") + "/";
    ($p | norm) as $want
    | [.MediaContainer.Directory[] | .key as $k | .Location[] | {k: $k, l: (.path | norm)}
       | select(.l as $l | $want | startswith($l))] | sort_by(.l | length) | last | .k // empty' "$dir/sections")
  [ -n "$key" ] || { log "no Plex library contains $p - skipped"; return; }
  if plex "/library/sections/$key/refresh" -G --data-urlencode "path=$p" > /dev/null; then
    log "asked Plex to scan $p (library $key)"
    printf '%s\tPlex scan\t%s\n' "$(date +%s)" "$p" >> /state/events.log
  else
    log "Plex scan request failed for $p"
  fi
}

log "watching /sources every ${POLL}s (depth $DEPTH), Plex at $PLEX_URL"
snapshot > "$dir/prev"
: > "$dir/pending"
while sleep "$POLL"; do
  snapshot > "$dir/cur"
  # new or modified folders, plus the parents of removed ones
  {
    comm -13 "$dir/prev" "$dir/cur" | cut -f2-
    cut -f2- "$dir/prev" | sort > "$dir/p"; cut -f2- "$dir/cur" | sort > "$dir/c"
    comm -23 "$dir/p" "$dir/c" | sed 's|/[^/]*$||'
  } | grep -v '^/sources$' | sort -u > "$dir/changed"
  mv "$dir/cur" "$dir/prev"

  if [ -s "$dir/changed" ]; then
    sort -u "$dir/changed" "$dir/pending" > "$dir/tmp" && mv "$dir/tmp" "$dir/pending"
    continue            # still changing - wait for a quiet poll
  fi
  [ -s "$dir/pending" ] || continue

  sleep "$SETTLE"
  plex "/library/sections" > "$dir/sections" || { log "cannot reach Plex at $PLEX_URL - will retry"; continue; }
  # scan the deepest folders only: drop any folder that contains another changed one
  while IFS= read -r path; do
    grep -qF "$path/" "$dir/pending" || scan "$path"
  done < "$dir/pending"
  : > "$dir/pending"
done
