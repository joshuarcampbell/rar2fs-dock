#!/usr/bin/env python3
"""Makes and checks the logins - a small stand-in for Apache's htpasswd.

The real one comes in a package with the whole Apache web server's history of
security bugs attached, for two things this does in a few lines. It takes the same
words, so nothing that calls it had to change:

    htpasswd -niB <user>            reads a password from the first line of its input
                                    and prints   <user>:<bcrypt hash>
    htpasswd -v -i <file> <user>    reads a password the same way and checks it against
                                    that user's line in <file>; exit code 0 if it matches

Only bcrypt hashes are made, and only bcrypt hashes are accepted - the kind rclone
checks too. Passwords never appear on the command line.
"""
import sys

import bcrypt


def read_password():
    return sys.stdin.buffer.readline().rstrip(b'\r\n')


def main(args):
    flags = ''.join(a[1:] for a in args if a.startswith('-'))
    words = [a for a in args if not a.startswith('-')]
    if 'v' in flags:                                        # check
        if len(words) != 2:
            return 2
        path, user = words
        password = read_password()
        try:
            with open(path, 'rb') as f:
                for line in f:
                    name, _, stored = line.rstrip(b'\r\n').partition(b':')
                    if name == user.encode() and stored.startswith((b'$2y$', b'$2a$', b'$2b$')):
                        # bcrypt itself only knows the $2b$ spelling of the same thing
                        return 0 if bcrypt.checkpw(password, b'$2b$' + stored[4:]) else 3
        except (OSError, ValueError):
            pass
        return 3
    if 'n' in flags and 'B' in flags:                       # make
        if len(words) != 1 or not words[0] or ':' in words[0]:
            sys.stderr.write('htpasswd: a user name, without ":", is needed\n')
            return 2
        password = read_password()
        if not password:
            sys.stderr.write('htpasswd: the password is empty\n')
            return 2
        # $2y$ is what Apache writes, and what the files made so far contain
        hashed = bcrypt.hashpw(password, bcrypt.gensalt(rounds=10))
        print('%s:%s' % (words[0], '$2y$' + hashed.decode()[4:]))
        return 0
    sys.stderr.write('htpasswd: use -niB <user>, or -v -i <file> <user>\n')
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
