#!/usr/bin/env python3
"""Serves the status page on port 8081 and starts a health report when asked.

  GET  /status.html, /health-report.txt ...   files from /state/www (status.html is
                                              rebuilt first if it is a few seconds old)
  GET  /status.json                           the same data for dashboards
  GET  /metrics                               the numbers, in Prometheus format
  GET  /recent.xml                            the newest items, as an RSS feed
  GET  /search?q=...                          looks through the library index
  POST /run-report  (form field: folder)      starts `run-health-report [folder]`
  POST /run-scan                              starts `library-scan` (sizes)

Every request needs a login from the same list as the drive (/tmp/htpasswd). The one
exception: if STATUS_TOKEN is set, /status.json, /metrics and /recent.xml also accept
?token=..., for dashboards and feed readers that can't send a user name and password.
The token can only read those three; it can't open the page or start anything.
It serves HTTPS using /tls/cert.pem and /tls/key.pem, unless TLS=0.
"""
import base64
import hashlib
import hmac
import html
import os
import re
import ssl
import subprocess
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

WWW = '/state/www'
HTPASSWD = '/tmp/htpasswd'
VIEW = '/view'
RUNNING = '/state/report.running'
STATUS_TOKEN = os.environ.get('STATUS_TOKEN', '')
TOKEN_PATHS = ('/status.json', '/metrics', '/recent.xml')      # all a token can read
ITEMS = '/state/library/items.tsv'
SCANNING = '/state/library.scanning'
CSS = '/usr/local/bin/page.css'
METRICS_TYPE = 'text/plain; version=0.0.4; charset=utf-8'
TYPES = {'.html': 'text/html; charset=utf-8', '.txt': 'text/plain; charset=utf-8',
         '.json': 'application/json', '.css': 'text/css', '.xml': 'application/rss+xml; charset=utf-8'}
FOLDER_OK = re.compile(r'^[^\x00-\x1f\\]{1,300}$')

_good = {}                  # sha256 of an accepted Authorization header -> expiry time
_good_lock = threading.Lock()
# Password guessing is slowed down rather than locked out: at most two checks run at
# once and every wrong one costs a second, so guessing is capped at about two a second
# however many connections are opened. (A lock-out would let anyone on the network
# shut the owner out, and behind Docker all clients can look like one address.)
_checks = threading.BoundedSemaphore(2)
WRONG_LOGIN_DELAY = 1.0


def login_ok(header):
    """True if the Basic-auth header matches a login in the htpasswd file."""
    if not header or not header.startswith('Basic '):
        return False
    key = hashlib.sha256(header.encode()).hexdigest()
    now = time.monotonic()
    with _good_lock:
        if _good.get(key, 0) > now:
            return True
    try:
        user, _, password = base64.b64decode(header[6:]).decode('utf-8').partition(':')
    except Exception:
        return False
    if not user or ':' in user or '\n' in user:
        return False
    # htpasswd checks the bcrypt hash; the password goes in on stdin, not the command line
    with _checks:
        try:
            result = subprocess.run(['htpasswd', '-v', '-i', HTPASSWD, user], input=password.encode(),
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
            ok = result.returncode == 0
        except Exception:
            ok = False
        if not ok:
            time.sleep(WRONG_LOGIN_DELAY)
    if not ok:
        return False
    with _good_lock:
        if len(_good) > 100:
            _good.clear()
        _good[key] = now + 600
    return True


_build_lock = threading.Lock()
FRESH_SECONDS = 4


def refresh_page():
    """Rebuild the status page if it is more than a few seconds old.

    The page fetches itself every few seconds while someone has it open, so this is
    what makes it live - and costs nothing when nobody is looking, because then only
    `monitor` rebuilds it, once a minute. One build at a time: a second request waits
    for the first one's result instead of starting its own.
    """
    page = os.path.join(WWW, 'status.html')

    def stale():
        try:
            return time.time() - os.path.getmtime(page) > FRESH_SECONDS
        except OSError:
            return True

    if not stale():
        return
    with _build_lock:
        if stale():
            try:
                subprocess.run(['status-page'], timeout=60, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass


class Handler(BaseHTTPRequestHandler):
    server_version = 'rar2fs-dock'
    sys_version = ''        # don't announce the Python version
    timeout = 30            # drop connections that go quiet

    def log_message(self, fmt, *args):
        pass                # keep `docker logs` for things that matter

    def _send(self, code, body=b'', content_type='text/plain; charset=utf-8', headers=()):
        self.send_response(code)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('X-Frame-Options', 'DENY')
        self.send_header('Referrer-Policy', 'same-origin')
        # the page is self-contained: nothing may be loaded from, or sent to, anywhere else
        # (connect-src: it fetches fresh copies of itself, from here only)
        self.send_header('Content-Security-Policy',
                         "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; "
                         "connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'")
        for name, value in headers:
            self.send_header(name, value)
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(body)

    def _authorised(self):
        if login_ok(self.headers.get('Authorization')):
            return True
        self._send(401, b'Login required\n', headers=[('WWW-Authenticate', 'Basic realm="rar2fs-dock"')])
        return False

    def _token_ok(self, url):
        if not STATUS_TOKEN or url.path not in TOKEN_PATHS:
            return False
        given = (urllib.parse.parse_qs(url.query).get('token') or [''])[0]
        return bool(given) and hmac.compare_digest(given.encode(), STATUS_TOKEN.encode())

    def do_GET(self):
        url = urllib.parse.urlparse(self.path)
        if not self._token_ok(url) and not self._authorised():
            return
        path = url.path
        if path in ('', '/'):
            return self._send(302, headers=[('Location', 'status.html')])
        if path == '/search':
            return self._search(urllib.parse.parse_qs(url.query).get('q', [''])[0])
        if path == '/metrics':
            full = os.path.join(WWW, 'metrics.txt')
            if not os.path.isfile(full):
                return self._send(404, b'Not ready yet\n')
            with open(full, 'rb') as f:
                return self._send(200, f.read(), METRICS_TYPE)
        name = os.path.basename(path)       # only files directly in WWW are served
        full = os.path.join(WWW, name)
        if path == '/status.html':
            refresh_page()
        if path != '/' + name or name.startswith('.') or not os.path.isfile(full):
            return self._send(404, b'Not found\n')
        with open(full, 'rb') as f:
            body = f.read()
        self._send(200, body, TYPES.get(os.path.splitext(name)[1], 'application/octet-stream'))

    do_HEAD = do_GET

    def _search(self, query):
        """A results page for /search?q=... - every word must appear in the name."""
        query = query.strip()[:200]
        words = [w for w in query.lower().split() if w]
        hits, total = [], 0
        if words:
            try:
                with open(ITEMS, encoding='utf-8', errors='replace') as f:
                    for line in f:
                        parts = line.rstrip('\n').split('\t')
                        if len(parts) < 5:
                            continue
                        name = parts[4].lower()
                        if all(w in name for w in words):
                            total += 1
                            if len(hits) < 200:
                                hits.append(parts)
            except OSError:
                pass
        hits.sort(key=lambda p: (int(p[0]), p[4].lower()))
        try:
            css = open(CSS, encoding='utf-8').read()
        except OSError:
            css = ''
        e = html.escape
        rows = ''.join(
            '<tr><td>%s%s</td><td><code>%s</code></td><td style="white-space:nowrap"><time data-t="%s"></time></td></tr>\n'
            % (e(p[4].replace('/', ' \u203a ')), '' if p[2] == 'd' else ' <span class="dim">(file)</span>', e(p[3]), e(p[1]))
            for p in hits)
        if not words:
            summary = 'Type part of a name above.'
        elif not total:
            summary = 'Nothing found for <b>%s</b>. The index covers the top two levels of each folder.' % e(query)
        else:
            summary = '<b>%d</b> found for <b>%s</b>%s' % (total, e(query), ' - showing the first 200' if total > 200 else '')
        page = (
            '<!doctype html><html lang="en"><head><meta charset="utf-8">'
            '<meta name="viewport" content="width=device-width, initial-scale=1"><title>Search - rar2fs-dock</title>'
            '<style>%s</style></head><body><main>'
            '<h1>Search</h1><p class="sub"><a href="status.html">&larr; Back to the status page</a></p>'
            '<form method="get" action="search" class="run" style="margin:0 0 16px">'
            '<input type="search" name="q" value="%s" placeholder="Search the library by name" required autofocus> '
            '<button type="submit">Search</button></form>'
            '<section><p>%s</p>%s</section>'
            '<script>for(const t of document.querySelectorAll("time[data-t]")){const d=new Date(t.dataset.t*1000);'
            'if(!isNaN(d)){t.textContent=d.toLocaleDateString();t.dateTime=d.toISOString()}}</script>'
            '</main></body></html>'
        ) % (css, e(query), summary,
             ('<table><tr><th>Name</th><th>Folder</th><th>Added</th></tr>%s</table>' % rows) if rows else '')
        self._send(200, page.encode('utf-8'), 'text/html; charset=utf-8')

    def do_POST(self):
        if not self._authorised():
            return
        action = urllib.parse.urlparse(self.path).path
        if action not in ('/run-report', '/run-scan'):
            return self._send(404, b'Not found\n')
        # The browser sends the login by itself, so make sure the request was made
        # from this page and not by some other site the user happens to have open.
        origin = self.headers.get('Origin') or self.headers.get('Referer') or ''
        if urllib.parse.urlparse(origin).netloc != self.headers.get('Host', ''):
            return self._send(403, b'This action can only be started from the status page.\n')
        try:
            length = max(0, min(int(self.headers.get('Content-Length') or 0), 4096))
        except ValueError:
            return self._send(400, b'Bad request.\n')
        form = urllib.parse.parse_qs(self.rfile.read(length).decode('utf-8', 'replace'))
        if action == '/run-scan':
            return self._start_scan()
        folder = (form.get('folder') or [''])[0].strip().strip('/')
        if folder:
            real = os.path.realpath(os.path.join(VIEW, folder))
            if not FOLDER_OK.match(folder) or not (real + '/').startswith(VIEW + '/') or not os.path.isdir(real):
                return self._send(400, b'Unknown folder.\n')
        # start it detached, so it keeps running whatever happens to this request
        command = ['sh', '-c', 'run-health-report "$@" > /dev/null 2>&1 &', 'run-health-report']
        if folder:
            command.append(folder)
        report = os.path.join(WWW, 'health-report.txt')
        before = os.path.getmtime(report) if os.path.exists(report) else 0
        subprocess.run(command, timeout=10)
        # Don't reload the page on a guess. Wait until the report has either marked
        # itself as running or (for a small folder) already finished, then rebuild
        # the page here, so what the browser gets next always shows the result.
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            finished = os.path.exists(report) and os.path.getmtime(report) > before
            if os.path.exists(RUNNING) or finished:
                break
            time.sleep(0.1)
        try:
            subprocess.run(['status-page'], timeout=60, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        self._send(303, headers=[('Location', 'status.html')])


    def _start_scan(self):
        """Start a size scan in the background, then show the page once it is under way."""
        scan = '/state/library/scan.json'
        before = os.path.getmtime(scan) if os.path.exists(scan) else 0
        subprocess.run(['sh', '-c', 'library-scan > /dev/null 2>&1 &'], timeout=10)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            finished = os.path.exists(scan) and os.path.getmtime(scan) > before
            if os.path.exists(SCANNING) or finished:
                break
            time.sleep(0.1)
        try:
            subprocess.run(['status-page'], timeout=60, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        self._send(303, headers=[('Location', 'status.html')])


class Server(ThreadingHTTPServer):
    """Does the HTTPS handshake on each connection's own thread.

    Wrapping the listening socket instead would do the handshake while accepting,
    one connection at a time - and a connection that opens but never finishes it
    (browsers keep spare ones like that) would block everyone else for good.
    """
    daemon_threads = True
    ssl_context = None

    def process_request_thread(self, request, client_address):
        if self.ssl_context is not None:
            try:
                request.settimeout(15)      # a handshake that stalls is dropped
                request = self.ssl_context.wrap_socket(request, server_side=True)
            except Exception:
                self.shutdown_request(request)
                return
        super().process_request_thread(request, client_address)


def main():
    server = Server(('0.0.0.0', 8081), Handler)
    if os.environ.get('TLS', '1') == '1':
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.minimum_version = ssl.TLSVersion.TLSv1_2
        context.load_cert_chain('/tls/cert.pem', '/tls/key.pem')
        server.ssl_context = context
    server.serve_forever()


if __name__ == '__main__':
    main()
