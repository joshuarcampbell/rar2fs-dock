# Server address and login for the rar2fs mounts.
# `sudo sh install.sh` creates this for you. To do it by hand, copy it to
# /etc/rar2fs/common.conf and chmod 600 it.
RCLONE_WEBDAV_URL=http://192.168.1.63:8765
RCLONE_WEBDAV_USER=rar2fs
# Output of: rclone obscure '<WEBDAV_PASS from .env>'
RCLONE_WEBDAV_PASS=
# Only with HTTPS (https:// address above): the server's tls/cert.pem, copied here
# RCLONE_CA_CERT=/etc/rar2fs/cert.pem
