# AppArmor profile for the rar2fs-dock container, for Linux hosts that use AppArmor.
#
# It is Docker's default profile with one addition: FUSE mounts are allowed, because
# rar2fs and mergerfs are FUSE filesystems. Every other kind of mount stays forbidden,
# which includes remounting the read-only source folders as writable.
#
# NOT YET TESTED on a real AppArmor host. If the container fails to mount its folders
# with this profile, remove APPARMOR_PROFILE from .env to go back to "unconfined".
#
# Install:
#   sudo cp rar2fs-dock /etc/apparmor.d/rar2fs-dock
#   sudo apparmor_parser -r /etc/apparmor.d/rar2fs-dock
#   then set APPARMOR_PROFILE=rar2fs-dock in .env and run: docker compose up -d

#include <tunables/global>

profile rar2fs-dock flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # ---- the addition: FUSE mounts only ----
  mount fstype=fuse,
  mount fstype=fuse.*,

  # ---- the rest is Docker's default profile ----
  signal (receive) peer=unconfined,
  signal (send,receive) peer=rar2fs-dock,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=rar2fs-dock,
}
